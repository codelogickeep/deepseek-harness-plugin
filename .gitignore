# ---- 依赖 ----
node_modules/

# ---- 敏感配置（绝不提交）----
# 环境变量：真实 .env 一律忽略，只允许 .env.example 模板
.env
.env.local
.env.*.local
!.env.example

# 运行时真实配置文件（可能含 key），只保留 example 模板
config/config.json
config/config.local.json
config/*.production.json

# ---- 运行时数据（会话映射含 identifier，私密）----
data/
logs/
*.log

# ---- 系统/编辑器 ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*.iml

# ---- 临时/构建 ----
tmp/
dist/
build/
coverage/
*.tgz

# ---- 运行时产物 ----
# 插件运行时生成的截图目录（browser-reader web_read_screenshot）
.dsh-web-read/

# ---- 本地 npm 缓存隔离目录 ----
.npm-cache/
