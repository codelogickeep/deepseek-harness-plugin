{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/dsh-client-ui-slots": ["./src/client/shims/dsh-client-ui-slots.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "lib"]
}
